<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Pomodoro</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/pomodoro.css" rel="stylesheet" />
</head>
<body class="corpoAplicacao">
<div class="d-flex">
    <nav class="barraLateral d-flex flex-column align-items-center py-3">
        <a href="/" class="iconeMenu mb-3" title="Timer">
            <i class="bi bi-list-task"></i>
        </a>
        <a href="/Tarefa" class="iconeMenu mb-3" title="Tarefas">
            <i class="bi bi-journal-plus"></i>
        </a>
        <a href="/Relatorio" class="iconeMenu mb-3" title="Relatório">
            <i class="bi bi-bar-chart"></i>
        </a>
        <a href="/Configuracoes" class="iconeMenu mb-3" title="Configurações">
            <i class="bi bi-gear"></i>
        </a>
    </nav>

    <main class="conteudoPrincipal flex-grow-1">
        @RenderBody()
    </main>
</div>

<script src="~/lib/angular/angular.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>