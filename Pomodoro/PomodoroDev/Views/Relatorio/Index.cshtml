@{
    ViewData["Title"] = "Relatorio";
}
<div id="paginaRelatorio" ng-app="appRelatorio" ng-controller="ControladorRelatorio">

    <div class="cabecalhoPagina d-flex justify-content-between align-items-center px-4 py-3">
        <h1 class="tituloPagina mb-0">Relatório</h1>
    </div>

    <div class="px-4 py-3">
        <div class="d-flex gap-3 mb-4 align-items-end">
            <div>
                <label class="tarefaRotulo">Data início</label>
                <input type="date" class="form-control tarefaCampo" ng-model="filtro.dataInicio" />
            </div>
            <div>
                <label class="tarefaRotulo">Data fim</label>
                <input type="date" class="form-control tarefaCampo" ng-model="filtro.dataFim" />
            </div>
            <button class="botaoPrimario" ng-click="buscar()">Buscar</button>
        </div>

        <div class="tarefaMensagemErro mb-3" ng-show="mensagemDeErro">{{ mensagemDeErro }}</div>

        <div ng-show="resumo">
            <div class="cabecalhoPagina pb-2 mb-3">
                <h2 class="tituloPagina">Resumo do período</h2>
            </div>
            <p>Pomodoros concluídos: <strong>{{ resumo.totalDePomodoros }}</strong></p>
            <p>Tempo total focado: <strong>{{ formatarSegundos(resumo.totalDeSegundosFocados) }}</strong></p>
        </div>

        <div ng-show="detalhe && detalhe.length > 0" class="mt-4">
            <div class="cabecalhoPagina pb-2 mb-3">
                <h2 class="tituloPagina">Por tarefa</h2>
            </div>
            <ul class="list-unstyled">
                <li class="itemLista d-flex justify-content-between align-items-center px-2"
                    ng-repeat="item in detalhe">
                    <span class="nomeDaTarefa">{{ item.nomeDaTarefa }}</span>
                    <span class="subtitulo">{{ item.pomodoros }} pomodoro(s) · {{ formatarSegundos(item.segundosFocados) }}</span>
                </li>
            </ul>
        </div>

        <div class="mensagemVazia" ng-show="buscou && resumo.totalDePomodoros === 0">
            Nenhuma sessão encontrada neste período.
        </div>
    </div>
</div>

@section Estilos {
    <link href="~/css/tarefa/tarefa.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/relatorio/relatorioModulo.js"></script>
    <script src="~/js/relatorio/relatorioControlador.js"></script>
}