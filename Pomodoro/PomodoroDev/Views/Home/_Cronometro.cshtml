<div class="px-4 py-3" ng-show="telaAtual === 'cronometro'">
    <div class="d-flex align-items-center mb-4">
        <button type="button" class="botaoVoltar me-3" ng-click="cancelarCiclo()"><i class="bi bi-arrow-left"></i></button>
        <h1 class="tituloPagina mb-0">{{ tarefaSelecionada.nomeDaTarefa }}</h1>
    </div>
    <div class="d-flex flex-column align-items-center">
        <div class="timerCirculo">
            <svg class="timerCirculoSvg" viewBox="0 0 220 220">
                <circle class="timerCirculoFundo" cx="110" cy="110" r="100"></circle>
                <circle class="timerCirculoProgresso" cx="110" cy="110" r="100"
                        ng-style="{ 'stroke-dashoffset': deslocamentoMinimoCirculo + (628.32 - deslocamentoMinimoCirculo) * (segundosRestantes / segundosTotaisDoCiclo) }"></circle>
            </svg>
            <div class="timerCirculoConteudo d-flex flex-column align-items-center">
                <span class="timerTempo">{{ tempoFormatado }}</span>
                <span class="timerEstado">{{ estadoCronometro }}</span>
            </div>
        </div>
        <div class="timerAcoes d-flex flex-column">
            <button class="botaoPrimario w-100" ng-click="alternarPausa()">{{ contagemEmAndamento ? 'Pausar' : 'Continuar' }}</button>
            <div class="timerAcoesSecundarias d-flex">
                <button class="botaoSecundario botaoExpandido" ng-click="encerrarCiclo()">Fim</button>
                <button class="botaoSecundario botaoExpandido" ng-click="cancelarCiclo()">Cancelar</button>
            </div>
        </div>
    </div>
</div>