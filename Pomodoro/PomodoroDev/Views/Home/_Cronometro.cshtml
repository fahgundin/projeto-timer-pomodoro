<div class="telaCronometro" ng-show="telaAtual === 'cronometro'">

    <button class="botaoVoltarCronometro d-flex align-items-center" ng-click="voltarParaLista()">
        <i class="bi bi-chevron-left"></i>
        <span class="ms-1">Foco</span>
    </button>

    <div class="caixaCronometro d-flex flex-column align-items-center">
        <span class="nomeTarefaCronometro">{{ tarefaSelecionada.nomeDaTarefa }}</span>

        <div class="circuloCronometro">
            <svg class="svgCirculo" viewBox="0 0 220 220">
                <circle class="circuloFundo" cx="110" cy="110" r="100"></circle>
                <circle class="circuloProgresso" cx="110" cy="110" r="100"></circle>
            </svg>
            <div class="conteudoCirculo d-flex flex-column align-items-center">
                <span class="tempoCronometro">{{ tempoFormatado }}</span>
                <span class="estadoCronometro">{{ estadoCronometro }}</span>
            </div>
        </div>

        <div class="acoesCronometro d-flex flex-column align-items-center">
            <button class="botaoContinuar" ng-click="alternarPausa()">
                {{ contagemEmAndamento ? 'Pausar' : 'Continuar' }}
            </button>
            <div class="acoesSecundarias d-flex">
                <button class="botaoFim" ng-click="encerrarCiclo()">Fim</button>
                <button class="botaoCancelar" ng-click="cancelarCiclo()">Cancelar</button>
            </div>
        </div>
    </div>
</div>